{
  // Type-check only. Node runs src/*.ts directly in development (type stripping),
  // and esbuild bundles the release build, so tsc never emits.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,

    // Imports name the .ts file, which Node's type stripping requires.
    "allowImportingTsExtensions": true,
    // Only syntax Node can strip: no enums, namespaces or parameter properties.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
